generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum CoverType {
  IMAGE
  VIDEO
}

enum Category {
  manutencao
  dicas
  alertas
  novidades
}

model Lead {
  id        Int      @id @default(autoincrement())
  nome      String
  telefone  String
  placa     String
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  contentHtml String     @db.Text
  category    Category
  coverUrl    String?
  coverType   CoverType  @default(IMAGE)
  status      PostStatus @default(DRAFT)
  publishAt   DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  views       Int        @default(0)

  @@index([status, publishAt])
}
