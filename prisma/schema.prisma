generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum CoverType {
  IMAGE
  VIDEO
}

enum Category {
  manutencao
  dicas
  alertas
  novidades
}

model Lead {
  id            Int      @id @default(autoincrement())
  tipo          String   @default("cotacao") // "cotacao" | "verificacao"
  nome          String?
  telefone      String?
  placa         String?
  protecaoAtual String?
  createdAt     DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  contentHtml String
  category    Category
  coverUrl    String?
  coverType   CoverType  @default(IMAGE)
  status      PostStatus @default(DRAFT)
  publishAt   DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  views       Int        @default(0)

  @@index([status, publishAt])
}
